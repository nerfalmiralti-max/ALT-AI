# ALT QR works locally without any environment variables.

# Local scan limits (all optional and bounded by application safety caps)
ALT_QR_MAX_PAGES=10
ALT_QR_CRAWL_CONCURRENCY=2
ALT_QR_PAGE_TIMEOUT_MS=15000
ALT_QR_SCAN_TIMEOUT_MS=120000
ALT_QR_MAX_REDIRECTS=5
ALT_QR_MAX_RESPONSE_BYTES=2000000
ALT_QR_MAX_RESOURCE_BYTES=5000000
ALT_QR_MAX_LINKS_PER_PAGE=40
ALT_QR_MAX_CONSOLE_EVENTS=200
ALT_QR_MAX_NETWORK_FAILURES=200
ALT_QR_MAX_DIALOGS=10
ALT_QR_MAX_POPUPS=5
ALT_QR_MAX_EVENT_TEXT_CHARS=2000
ALT_QR_MAX_DOM_EVIDENCE_ITEMS=250
ALT_QR_MAX_RESOURCE_URL_CHARS=8192
# Required only when a development scan intentionally targets localhost/private IPs.
ALT_QR_ALLOW_PRIVATE_TARGETS=true

# Optional persistence mirror. Never expose the service role key to the browser.
ALT_QR_STORAGE=local
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# ALT_QR_OWNER_ID=local
